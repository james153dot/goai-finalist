{
  "project": {
    "name": "cswe",
    "version": "0.1.0",
    "track": "GOAI Track 3",
    "subtrack": "Open Exploration / Type II"
  },
  "submission_contract": {
    "minimal_runnable_environment": "src/cswe/ with committed OpenFOAM mixing atlas",
    "complete_exploration_logs": "artifacts/cfd_study_s*/ai/exploration.jsonl and matched baseline logs",
    "reference_frame": "matched-budget Latin hypercube baseline; random baseline additionally retained in atlas studies",
    "readme": "README.md",
    "reproduction": "REPRODUCTION.md",
    "self_check": "GOAI_OPEN_EXPLORATION_CHECKLIST.md"
  },
  "environment": {
    "openfoam": "14",
    "python": ">=3.11",
    "python_lock": "uv.lock",
    "analog": {
      "omega0": 11.0,
      "damping": 0.08,
      "heat_release_scale": 1.45,
      "threshold": "sigma_analog = 0",
      "q_mix": "Var_y[Z](x); mixing-availability proxy, not heat release; Z stored as OpenFOAM field T; JSON key q_profile",
      "pressure_mode": "cos(pi x / L) closed-closed 1L",
      "design_vector": "z = [g, d, a, s, o]",
      "tau": "first of 24 equal-width axial bins with Var_y[Z] < 0.045 (absolute); tau = max(1e-4, x_m / U_b); last-bin fallback; no interpolation",
      "n_index": "n = 0.50 + 0.28 tanh(C-1) + 0.16 (1-Um) + 0.10 (o-0.5)^2; g,d,a,s enter only through OpenFOAM C and Um",
      "near_boundary_sigma_mae": "E_sigma,boundary = mean |hat_sigma(z)-sigma| on hold-out |sigma|<0.20; not Hausdorff/contour distance",
      "unstable_precision": "TP_U / (TP_U + FP_U) on hold-out; 0 if the GP predicts no unstable points"
    }
  },
  "protocol": {
    "live_budget": 16,
    "n_init": 5,
    "holdout_size": 24,
    "holdout_seed": 123,
    "atlas_n": 35,
    "atlas_seed": 7,
    "matched_bounds": true,
    "ai_init_is_latin_hypercube": true,
    "holdout_used_for_training": false,
    "holdout_used_for_query_selection": false
  },
  "primary_live_seeds": [8, 11, 14, 19, 23, 26, 32, 35],
  "artifacts": {
    "atlas": "artifacts/mixing_atlas.json",
    "holdout": "artifacts/of_test.json",
    "seed_study": "artifacts/seed_study.json",
    "sensitivity": "artifacts/sensitivity.json",
    "tau_sensitivity": "artifacts/tau_sensitivity.json",
    "g_sweep": "artifacts/g_sweep.json",
    "swirl_sweep": "artifacts/swirl_sweep.json",
    "live_cfd_summary": "artifacts/cfd_live_summary.json",
    "live_campaign_glob": "artifacts/cfd_study_s*/",
    "live_expansion_glob": "artifacts/cfd_expansion_s*/",
    "live_expansion_summary": "artifacts/cfd_live_expansion.json",
    "live_pooled_summary": "artifacts/cfd_live_pooled.json",
    "g_sweep_mesh_verification": "artifacts/g_sweep_mesh_verification.json",
    "figures": "artifacts/figures/",
    "sample_efficiency": "artifacts/sample_efficiency_live.json",
    "ablation": "artifacts/ablation_study.json",
    "verification": "artifacts/verification.json",
    "final_validation": "artifacts/final_validation.json",
    "final_validation_holdout": "artifacts/final_validation_holdout.json"
  },
  "artifact_provenance": {
    "audited_base_commit": "28328f1407d9a28c64b80a4f8b1ca2a4642a6062",
    "raw_numerical_artifacts_preserved": true,
    "legacy_validity_field": "Cconv",
    "current_validity_field": "Cvalid",
    "reader_policy": "row.get('Cvalid', row.get('Cconv', False))",
    "interpretation_revision": "Sparse multivariate neighbor evidence challenges hypotheses but is not treated as a controlled causal falsification or proof of 5-D topology.",
    "details": "ARTIFACT_PROVENANCE.md"
  },
  "disclosure": {
    "external_datasets": [],
    "external_trained_models": [],
    "commercial_apis": [],
    "proprietary_engine_geometry_or_measurements": false,
    "generated_data": "synthetic 2-D OpenFOAM mixing fields produced for this project",
    "direct_dependencies": "pyproject.toml",
    "resolved_dependencies": "uv.lock",
    "third_party_licenses": "THIRD_PARTY.md",
    "project_license": "MIT"
  },
  "judge_entrypoints": {
    "minimum_reproduction": "python3 -m pip install -e \".[dev]\" && cswe reproduce",
    "submission_check": "python3 tools/check_open_exploration.py",
    "tests": "python3 -m pytest",
    "dashboard": "streamlit run app/dashboard.py --server.port 48217 --server.address 0.0.0.0",
    "optional_uv": "uv sync && uv run cswe reproduce"
  }
}
